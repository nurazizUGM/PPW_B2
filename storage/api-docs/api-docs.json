                                            },
                                            "photo": {
                                                "type": "string",
                                                "example": "buku.jpg"
                                            }
                                        },
                                        "type": "object"
                                    }
                                },
                                "example": [
                                    {
                                        "id": 1,
                                        "judul": "Ducimus blanditiis",
                                        "penulis": "Pariatur Vel et cor",
                                        "harga": "97",
                                        "tgl_terbit": "1984-07-23",
                                        "created_at": "2024-11-20T02:35:11.000000Z",
                                        "updated_at": "2024-11-20T02:35:11.000000Z",
                                        "photo": "OFYOvtyCZW3oL3C29OurHKFRr6g0ysl0ssUuumIm.jpg"
                                    }
                                ]
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Buku"
                ],
                "operationId": "17d1429cfe1ba64127b7794520e46c85",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "judul": {
                                        "type": "string",
                                        "example": "Belajar PHP"
                                    },
                                    "penulis": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "harga": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 99.99
                                    },
                                    "tgl_terbit": {
                                        "type": "integer",
                                        "example": 2021
                                    },
                                    "photo": {
                                        "type": "string",
                                        "format": "binary",
                                        "example": "buku.jpg"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Store data buku",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Data berhasil disimpan"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/greet": {
