    "paths": {
        "/api/buku": {
            "get": {
                "tags": [
                    "Buku"
                ],
                "operationId": "ad144718c94735e4b410f4451f86cbf1",
                "responses": {
                    "200": {
                        "description": "Get all data buku",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "judul": {
                                                "type": "string",
                                                "example": "Belajar PHP"
                                            },
                                            "penulis": {
                                                "type": "string",
                                                "example": "John Doe"
                                            },
                                            "harga": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 99.99
                                            },
                                            "tgl_terbit": {
                                                "type": "integer",
                                                "example": 2021
                                            },
                                            "created_at": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2021-08-01T00:00:00.000000Z"
                                            },
                                            "updated_at": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2021-08-01T00:00:00.000000Z"
                                            },
                                            "photo": {
                                                "type": "string",
                                                "example": "buku.jpg"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Buku"
                ],
                "operationId": "17d1429cfe1ba64127b7794520e46c85",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "judul": {
                                        "type": "string",
                                        "example": "Belajar PHP"
                                    },
                                    "penulis": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "harga": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 99.99
                                    },
                                    "tgl_terbit": {
                                        "type": "integer",
                                        "example": 2021
                                    },
                                    "photo": {
                                        "type": "string",
                                        "format": "binary",
                                        "example": "buku.jpg"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Store data buku",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Data berhasil disimpan"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/gallery": {
            "get": {
                "tags": [
                    "Gallery"
                ],
                "description": "Get all posts with picture",
